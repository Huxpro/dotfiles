{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Windows: Ctrl + Option + 1 cycles center / full screen / restore (through Rectangle)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "1",
                                    "modifiers": {
                                        "mandatory": [
                                            "control",
                                            "option"
                                        ],
                                        "optional": [
                                            "caps_lock"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "f=\"${TMPDIR:-/tmp}/rectangle-one\"; now=$(/bin/date +%s); i=0; t=0; [ -f \"$f\" ] && read i t <\"$f\"; [ $((now - t)) -gt 2 ] && i=0; case $i in 0) a=center;; 1) a=maximize;; *) a=restore;; esac; echo \"$(( (i + 1) % 3 )) $now\" >\"$f\"; /usr/bin/open -g \"rectangle://execute-action?name=$a\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Windows: Ctrl + Option + 2 alternates left half / right half (through Rectangle)",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "2",
                                    "modifiers": {
                                        "mandatory": [
                                            "control",
                                            "option"
                                        ],
                                        "optional": [
                                            "caps_lock"
                                        ]
                                    }
                                },
                                "conditions": [
                                    {
                                        "type": "variable_if",
                                        "name": "window_halves_side",
                                        "value": 1
                                    }
                                ],
                                "to": [
                                    {
                                        "key_code": "right_arrow",
                                        "modifiers": [
                                            "left_control",
                                            "left_option"
                                        ]
                                    },
                                    {
                                        "set_variable": {
                                            "name": "window_halves_side",
                                            "value": 0
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "2",
                                    "modifiers": {
                                        "mandatory": [
                                            "control",
                                            "option"
                                        ],
                                        "optional": [
                                            "caps_lock"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_arrow",
                                        "modifiers": [
                                            "left_control",
                                            "left_option"
                                        ]
                                    },
                                    {
                                        "set_variable": {
                                            "name": "window_halves_side",
                                            "value": 1
                                        }
                                    }
                                ],
                                "parameters": {
                                    "basic.to_delayed_action_delay_milliseconds": 2000
                                },
                                "to_delayed_action": {
                                    "to_if_invoked": [
                                        {
                                            "set_variable": {
                                                "name": "window_halves_side",
                                                "value": 0
                                            }
                                        }
                                    ],
                                    "to_if_canceled": [
                                        {
                                            "set_variable": {
                                                "name": "window_halves_side",
                                                "value": 0
                                            }
                                        }
                                    ]
                                }
                            }
                        ]
